# Copy this file to .env and fill in your values.

# 1) Create a bot with @BotFather on Telegram, then paste its token here.
TELEGRAM_BOT_TOKEN=1234567890:AAAA-your-bot-token

# 2) Comma-separated Telegram user IDs allowed to use this bot (REQUIRED).
#    This is the only access boundary — the agent has real write access
#    on the machine running this bot. Find your ID by messaging @userinfobot.
ALLOWED_TELEGRAM_IDS=123456789

# Optional overrides (defaults shown):
# KIMCHI_MODEL=glm-5.3
# KIMCHI_ALLOW_TOOLS=read,write,edit,ls,find,grep
# KIMCHI_TIMEOUT=600
# KIMCHI_JS=C:\Users\you\AppData\Roaming\npm\node_modules\@getkimchi\kimchi\bin\kimchi.js
